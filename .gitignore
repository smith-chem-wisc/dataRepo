# /project — tracked vs ignored. Code worktrees + large data own their own remotes / are recorded.

# Source worktrees (push to their own forks; recorded in code/PINNED.md)
/code/*/
!/code/PINNED.md
!/code/reviews/
!/code/reviews/**

# Raw data & databases (recorded in data/PROVENANCE.md, not committed)
*.raw
*.mzML
*.mzml
*.d/
*.fasta
*.msl
*.db
/data/raw/
/data/**/*.raw
/data/**/*.mzML

# Quarantine
/.project/attic/

# Office lock files & build outputs
~$*
*.tmp
bin/
obj/
__pycache__/
.ipynb_checkpoints/
*.egg-info/
.pytest_cache/
.ruff_cache/
/build/
/dist/
/.venv/

# Bundle stores. dataRepo is code, not data (D8): bundles belong in the producing instance.
/store/
*.parquet
# The one exception: the C# port's test fixture, a bundle the Python ingester wrote (see its PROVENANCE.md).
!/dotnet/tests/DataRepo.Tests/Fixtures/**/*.parquet

# Cross-project thread read-state: per-machine, not project truth
.project/threads.state

# A user running examples/study_delivery/study.yaml without --store lands here.
.tmp-example-store/
